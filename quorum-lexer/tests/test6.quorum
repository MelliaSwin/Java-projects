class BossFight
    action Battle
        integer health = 100
        integer damage[3]
        damage[0] = 10
        damage[1] = 25
        damage[2] = 40

        integer index = 0

        if health not= 0
            say "The battle begins!"
        end

        health = health - damage [index]
        index = index + 1

        if health Not= 0
            say "The boss is still standing."
        end